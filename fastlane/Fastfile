# frozen_string_literal: true
# Delegates to the same explicit Xcode archive/export/upload path used locally.
require 'shellwords'

default_platform(:mac)

TEXTRACTOR_ROOT = File.expand_path('..', __dir__)

def run_release_action(action, options)
  platform = options[:platform] || 'macos'
  UI.user_error!('platform must be macos or ios') unless %w[macos ios].include?(platform)
  args = ['bash', File.join(TEXTRACTOR_ROOT, 'scripts/archive_appstore.sh'),
          '--platform', platform, '--action', action]
  {version: '--version', build: '--build', archive_path: '--archive-path'}.each do |key, flag|
    args += [flag, options[key].to_s] if options[key]
  end
  args << '--unsigned' if options[:unsigned] == true || options[:unsigned].to_s == 'true'
  if options[:allow_provisioning_updates] == true || options[:allow_provisioning_updates].to_s == 'true'
    args << '--allow-provisioning-updates'
  end
  sh(args.shelljoin)
end

platform :mac do
  desc 'Create a candidate archive only; does not upload or submit for review'
  lane :build do |options|
    run_release_action('archive', options)
  end

  desc 'Export an existing signed candidate as a Mac App Store package or iOS IPA'
  lane :export do |options|
    run_release_action('export', options)
  end

  desc 'Upload an approved existing archive; does not submit for review or publish'
  lane :upload do |options|
    run_release_action('upload', options)
  end

  desc 'Compatibility alias for build only; export/upload remain explicit actions'
  lane :release do |options|
    run_release_action('archive', options)
  end
end
