# frozen_string_literal: true
# Optional, explicitly invoked certificate synchronization. The release scripts
# do not invoke match or generate certificates. Existing Xcode signing also works.
storage_mode('git')
git_url(ENV['MATCH_GIT_URL']) if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
git_branch('main')
type('appstore')
readonly(true)
app_identifier(ENV.fetch('APP_IDENTIFIER', 'com.textractor.app'))
username(ENV['APPLE_ID']) if ENV['APPLE_ID'] && !ENV['APPLE_ID'].empty?
team_id(ENV['TEAM_ID']) if ENV['TEAM_ID'] && !ENV['TEAM_ID'].empty?
keychain_name(ENV['MATCH_KEYCHAIN_NAME']) if ENV['MATCH_KEYCHAIN_NAME']
keychain_password(ENV['MATCH_KEYCHAIN_PASSWORD']) if ENV['MATCH_KEYCHAIN_PASSWORD']
