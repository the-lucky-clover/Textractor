# Textractor fastlane environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# App Store Connect API Key (Preferred)
# Create at: https://appstoreconnect.apple.com/access/api
# ============================================================
ASC_API_ISSUER_ID="your-issuer-id-from-app-store-connect"
ASC_API_KEY_ID="your-key-id-from-app-store-connect"
ASC_API_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"

# ============================================================
# Legacy Apple ID Authentication (Alternative)
# ============================================================
# APPLE_ID="your-apple-id@example.com"
# ASC_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"  # App-specific password from appleid.apple.com

# ============================================================
# Team & App Configuration
# ============================================================
TEAM_ID="YOUR_TEAM_ID"                    # 10-char Team ID from developer.apple.com
APP_IDENTIFIER="com.textractor.app"       # Your bundle identifier
APPLE_ID="your-apple-id@example.com"      # Your Apple ID email

# ============================================================
# Code Signing (Match)
# ============================================================
MATCH_PASSWORD="your-match-repo-password" # Password for match git repo
MATCH_GIT_URL="https://github.com/yourorg/certificates.git"  # Private repo for certs
MATCH_TYPE="appstore"                     # appstore, development, adhoc, enterprise
MATCH_KEYCHAIN_NAME="fastlane_tmp_keychain"
MATCH_KEYCHAIN_PASSWORD="temp_password"

# ============================================================
# Slack Notifications (Optional)
# ============================================================
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/XXX/XXX"
SLACK_CHANNEL="#releases"
SLACK_USERNAME="Textractor Bot"

# ============================================================
# CI/CD Specific
# ============================================================
# GITHUB_TOKEN="ghp_xxxxxxxxxxxx"        # For GitHub Actions
# GIT_AUTHOR_NAME="Fastlane Bot"
# GIT_AUTHOR_EMAIL="fastlane@example.com"

# ============================================================
# Build Configuration
# ============================================================
BUILD_CONFIGURATION="Release"
SCHEME="Textractor"
PROJECT_PATH="./Package.swift"  # or .xcodeproj/.xcworkspace
OUTPUT_DIR="./build/fastlane"

# ============================================================
# TestFlight / App Store Connect
# ============================================================
# ITC_TEAM_ID="12345678"              # iTunes Connect Team ID (may differ from TEAM_ID)
# TESTFLIGHT_GROUPS="Beta Testers,Internal"
# TESTFLIGHT_CHANGELOG="See GitHub releases"

# ============================================================
# macOS Specific
# ============================================================
MACOS_DEPLOYMENT_TARGET="14.0"
CODE_SIGN_IDENTITY="3rd Party Mac Developer Application"
INSTALLER_CODE_SIGN_IDENTITY="3rd Party Mac Developer Installer"

# ============================================================
# Notarization
# ============================================================
# Uses ASC_API_* above, or:
# NOTARIZATION_APPLE_ID="your-apple-id@example.com"
# NOTARIZATION_PASSWORD="app-specific-password"
# NOTARIZATION_TEAM_ID="YOUR_TEAM_ID"