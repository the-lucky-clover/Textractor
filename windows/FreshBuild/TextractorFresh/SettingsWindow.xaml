<Window x:Class="Textractor.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Textractor.Windows.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#FF0D100B"
        ShowInTaskbar="False"
        Topmost="True"
        Width="232"
        Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Border Background="#FF0D100B" BorderBrush="#FF6BB534" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="BannerBorder"
                    Grid.Row="0"
                    Background="#FF0D100B"
                    Width="243.6"
                    Height="57.5"
                    Margin="0,0,0,-2.9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ClipToBounds="True">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,243.6,57.5" RadiusX="28" RadiusY="28" />
                </Border.Clip>
                <Image x:Name="BannerImage"
                       Source="pack://application:,,,/Resources/textractor-type.png"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,-2.9,0,0">
                <StackPanel x:Name="ContentPanel" Orientation="Vertical" Margin="8,0,8,6">
                    <TextBlock Text="AI &amp; EXTRACTION" Style="{StaticResource SectionLabelStyle}" x:Name="Section1Label" />
                    
                    <Border Style="{StaticResource BreakingDadCardStyle}" x:Name="WeirdnessCard">
                        <StackPanel Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                           Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Inference weirdness" 
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="WeirdnessValueText" Text="45%" 
                                           FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" 
                                           Foreground="#FF6BB534" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </Grid>
                            <Slider x:Name="WeirdnessSlider" Minimum="0" Maximum="1" Value="0.45"
                                    Foreground="#FF6BB534"
                                    ValueChanged="WeirdnessSlider_ValueChanged" />
                            <TextBlock Text="0% strict · 100% aggressive correction &amp; more retries."
                                       FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="#88888888" Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource BreakingDadCardStyle}" x:Name="VocabCard">
                        <StackPanel Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8E1;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                           Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Custom vocabulary (comma-separated)" 
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox x:Name="VocabTextBox" 
                                     Style="{StaticResource TextBoxStyle}" />
                            <Button Content="SAVE VOCABULARY" Style="{StaticResource BreakingDadButtonStyle}"
                                    Click="SaveVocab_Click" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ResetDefaultsButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="RESET TO DEFAULTS"
                            Tag="reset"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="SHARING" Style="{StaticResource SectionLabelStyle}" x:Name="Section2Label" />

                    <Button x:Name="PastePlainTextButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="PASTE AS PLAIN TEXT"
                            Tag="paste_plain"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="PastePlainToggle" IsChecked="True" Checked="PastePlainToggle_Checked" Unchecked="PastePlainToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="QUICK-SHARE CHIPS" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Black"
                               Foreground="#88888888" Margin="10,6,10,2" x:Name="QuickShareLabel" />

                    <Button x:Name="ShareMailButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="MAIL"
                            Tag="share_mail"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="ShareMailToggle" IsChecked="True" Checked="ShareMailToggle_Checked" Unchecked="ShareMailToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="ShareMessageButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="MESSAGE"
                            Tag="share_message"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="ShareMessageToggle" IsChecked="True" Checked="ShareMessageToggle_Checked" Unchecked="ShareMessageToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="ShareAirDropButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="AIRDROP"
                            Tag="share_airdrop"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="ShareAirDropToggle" IsChecked="True" Checked="ShareAirDropToggle_Checked" Unchecked="ShareAirDropToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="WINDOW CAPTURES" Style="{StaticResource SectionLabelStyle}" x:Name="Section3Label" />

                    <Button x:Name="WindowTableButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="CONVERT TO MARKDOWN TABLES"
                            Tag="window_table"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7CD;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="WindowTableToggle" IsChecked="True" Checked="WindowTableToggle_Checked" Unchecked="WindowTableToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="UPDATES" Style="{StaticResource SectionLabelStyle}" x:Name="Section4Label" />

                    <Border Style="{StaticResource BreakingDadCardStyle}" x:Name="UpdatesCard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                       Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="Version 2.0.0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" />
                                <TextBlock x:Name="LastCheckedText" Text="Last checked: Never" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="#88888888" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="CHECK NOW" Style="{StaticResource BreakingDadButtonStyle}"
                                    Foreground="#FF6BB534" BorderBrush="#FF6BB534" Click="CheckUpdates_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="HISTORY" Style="{StaticResource SectionLabelStyle}" x:Name="Section5Label" />

                    <Button x:Name="OpenHistoryButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="OPEN HISTORY"
                            Tag="history"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabelStyle}" x:Name="Section6Label" />

                    <Button x:Name="FlattenButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="FLATTEN TEXT (NO LINE BREAKS)"
                            Tag="flatten"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="FlattenToggle" Checked="FlattenToggle_Checked" Unchecked="FlattenToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="ReduceMotionButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="REDUCE MOTION"
                            Tag="reduce_motion"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8AE;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="ReduceMotionToggle" Checked="ReduceMotionToggle_Checked" Unchecked="ReduceMotionToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="TelemetryButton"
                            Style="{StaticResource MenuRowStyle}"
                            Content="LOCAL TELEMETRY LOG"
                            Tag="telemetry"
                            Click="MenuRow_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE91F;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                               Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" x:Name="TelemetryToggle" IsChecked="True" Checked="TelemetryToggle_Checked" Unchecked="TelemetryToggle_Unchecked" />
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="ABOUT" Style="{StaticResource SectionLabelStyle}" x:Name="Section7Label" />

                    <Border Style="{StaticResource BreakingDadCardStyle}" x:Name="AboutCard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Medium" 
                                       Foreground="#FF6BB534" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="Textractor · on-device OCR" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" />
                                <TextBlock Text="Built for your privacy and your eyes." FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="#88888888" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="BY LUCKY CLOVER" Style="{StaticResource BreakingDadButtonStyle}"
                                    Foreground="#FF6BB534" BorderBrush="#FF6BB534" Click="OpenCredits_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>