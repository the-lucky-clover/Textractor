<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Textractor.Windows">

    <!-- ============================================================
         BreakingDad Color Palette (matching macOS exactly)
         ============================================================ -->
    
    <!-- Primary Accent: Toxic Green #6BB534 -->
    <Color x:Key="BreakingDadToxicGreenColor">#FF6BB534</Color>
    <SolidColorBrush x:Key="BreakingDadToxicGreenBrush" Color="{StaticResource BreakingDadToxicGreenColor}" />
    
    <!-- Deep Green #2E5C1C -->
    <Color x:Key="BreakingDadDeepGreenColor">#FF2E5C1C</Color>
    <SolidColorBrush x:Key="BreakingDadDeepGreenBrush" Color="{StaticResource BreakingDadDeepGreenColor}" />
    
    <!-- Meth Blue / Crystal Blue #29ABE0 -->
    <Color x:Key="BreakingDadMethBlueColor">#FF29ABE0</Color>
    <SolidColorBrush x:Key="BreakingDadMethBlueBrush" Color="{StaticResource BreakingDadMethBlueColor}" />
    
    <!-- Hazmat Yellow #F5C714 -->
    <Color x:Key="BreakingDadHazmatYellowColor">#FFF5C714</Color>
    <SolidColorBrush x:Key="BreakingDadHazmatYellowBrush" Color="{StaticResource BreakingDadHazmatYellowColor}" />
    
    <!-- Caution Orange #E67321 -->
    <Color x:Key="BreakingDadCautionOrangeColor">#FFE67321</Color>
    <SolidColorBrush x:Key="BreakingDadCautionOrangeBrush" Color="{StaticResource BreakingDadCautionOrangeColor}" />
    
    <!-- Rust Red #B8291F -->
    <Color x:Key="BreakingDadRustColor">#FFB8291F</Color>
    <SolidColorBrush x:Key="BreakingDadRustBrush" Color="{StaticResource BreakingDadRustColor}" />
    
    <!-- Chalk / Off-white #E6EADC -->
    <Color x:Key="BreakingDadChalkColor">#FFE6EADC</Color>
    <SolidColorBrush x:Key="BreakingDadChalkBrush" Color="{StaticResource BreakingDadChalkColor}" />
    
    <!-- Green-Black Backdrop #0B100A -->
    <Color x:Key="BreakingDadGreenBlackColor">#FF0B100A</Color>
    <SolidColorBrush x:Key="BreakingDadGreenBlackBrush" Color="{StaticResource BreakingDadGreenBlackColor}" />
    
    <!-- Header Background (shared with popover) #0D100B -->
    <Color x:Key="TextractorHeaderBackgroundColor">#FF0D100B</Color>
    <SolidColorBrush x:Key="TextractorHeaderBackgroundBrush" Color="{StaticResource TextractorHeaderBackgroundColor}" />
    
    <!-- Gradient: Toxic Green → Hazmat Yellow -->
    <LinearGradientBrush x:Key="BreakingDadGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BreakingDadToxicGreenColor}" Offset="0" />
        <GradientStop Color="{StaticResource BreakingDadHazmatYellowColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         Semantic Colors
         ============================================================ -->
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BreakingDadToxicGreenColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFF44336" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF2196F3" />

    <!-- ============================================================
         Typography Constants
         ============================================================ -->
    
    <sys:Double x:Key="HudTitleFontSize">20</sys:Double>
    <sys:Double x:Key="HudHeadFontSize">13</sys:Double>
    <sys:Double x:Key="HudMonoFontSize">11</sys:Double>
    <sys:Double x:Key="HudCapsFontSize">10</sys:Double>
    <sys:Double x:Key="SectionLabelFontSize">10</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">9</sys:Double>

    <sys:Double x:Key="CardCornerRadius">10</sys:Double>
    <sys:Double x:Key="ButtonCornerRadius">7</sys:Double>
    <sys:Double x:Key="ToastCornerRadius">16</sys:Double>
    <sys:Double x:Key="SplashCornerRadius">28</sys:Double>
    <sys:Double x:Key="WindowCornerRadius">12</sys:Double>
    <sys:Double x:Key="CapsuleCornerRadius">100</sys:Double>

    <!-- ============================================================
         Font Families
         ============================================================ -->
    
    <FontFamily x:Key="HudTitleFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="HudMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================================================
         Font Weights
         ============================================================ -->
    
    <FontWeight x:Key="HudTitleFontWeight">Black</FontWeight>
    <FontWeight x:Key="HudHeadFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="HudMonoFontWeight">Medium</FontWeight>
    <FontWeight x:Key="HudCapsFontWeight">Black</FontWeight>
    <FontWeight x:Key="SectionLabelFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="BodyFontWeight">Normal</FontWeight>
    <FontWeight x:Key="CaptionFontWeight">Medium</FontWeight>

    <!-- ============================================================
         Styles
         ============================================================ -->
    
    <!-- Section Label Style -->
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudTitleFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource SectionLabelFontWeight}" />
        <Setter Property="Foreground" Value="#88888888" />
        <Setter Property="Padding" Value="10,6,10,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- HUD Caps TextBlock Style -->
    <Style x:Key="HudCapsTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCapsFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource HudCapsFontWeight}" />
        <Setter Property="Foreground" Value="{StaticResource BreakingDadChalkBrush}" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <!-- Body Text Style -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudTitleFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource BodyFontWeight}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Caption Text Style -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource CaptionFontWeight}" />
        <Setter Property="Foreground" Value="#88888888" />
    </Style>

    <!-- BreakingDad Card Style -->
    <Style x:Key="BreakingDadCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BreakingDadDeepGreenBrush}" />
        <Setter Property="Opacity" Value="0.22" />
        <Setter Property="BorderBrush" Value="{StaticResource BreakingDadToxicGreenBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF6BB534" Opacity="0.35" BlurRadius="14" ShadowDepth="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BreakingDad Button Style (Pill) -->
    <Style x:Key="BreakingDadButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BreakingDadToxicGreenBrush}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="Foreground" Value="{StaticResource BreakingDadToxicGreenBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HudCapsFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource HudCapsFontWeight}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu Row Style (for popover/menu items) -->
    <Style x:Key="MenuRowStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource HudTitleFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource BodyFontWeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BreakingDadToxicGreenBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toast Card Style -->
    <Style x:Key="ToastCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#CC0D100B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BreakingDadToxicGreenBrush}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox Style -->
    <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BreakingDadGreenBlackBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BreakingDadToxicGreenBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource HudTitleFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>