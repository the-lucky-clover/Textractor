<Window x:Class="Textractor.Windows.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp">

    <Border Background="Transparent">
        <Grid x:Name="RootGrid" Background="Transparent">
            <Border x:Name="ScrimBorder"
                    Background="#2E000000"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <Canvas x:Name="CrosshairCanvas"
                    IsHitTestVisible="False" />

            <Border x:Name="SelectionRectBorder"
                    BorderBrush="#FF6BB534"
                    BorderThickness="1.2"
                    Background="#0FFFFFFF"
                    Visibility="Collapsed" />

            <Canvas x:Name="HandlesCanvas" IsHitTestVisible="False" Visibility="Collapsed" />

            <Canvas x:Name="WindowOutlinesCanvas" IsHitTestVisible="False" />

            <Border x:Name="WindowGlowBorder"
                    Background="#1A6BB534"
                    BorderBrush="#FF6BB534"
                    BorderThickness="2.5"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect x:Name="WindowGlowShadow"
                        Color="#FF6BB534"
                        Opacity="0.45"
                        BlurRadius="14"
                        ShadowDepth="0" />
                </Border.Effect>
            </Border>

            <Border x:Name="WindowInfoBorder"
                    Background="#D10B100A"
                    BorderBrush="#FF6BB534"
                    BorderThickness="1.6"
                    Padding="8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#FF6BB534" Opacity="0.6" BlurRadius="16" ShadowDepth="0" />
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="WindowNameText"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               FontWeight="Black"
                               Foreground="White" />
                    <TextBlock x:Name="WindowSizeText"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               FontWeight="Black"
                               Foreground="#FFF5C714" />
                </StackPanel>
            </Border>

            <Ellipse x:Name="CursorCircle"
                     Width="22" Height="22"
                     Stroke="White"
                     StrokeThickness="1"
                     Opacity="0.85"
                     IsHitTestVisible="False"
                     Visibility="Collapsed" />

            <Border x:Name="StatusBarBorder"
                    Background="#800D100B"
                    BorderBrush="#FF6BB534"
                    BorderThickness="1"
                    Padding="14,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,18,0,0"
                    MaxWidth="420"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="#FF6BB534" Opacity="0.35" BlurRadius="14" ShadowDepth="0" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="&#xE9C9;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Black" 
                               Foreground="#FF6BB534" Margin="0,0,6,0" VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Column="1" Text="TEXTRACTOR CAPTURE" 
                               FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" 
                               Foreground="White" Margin="0,0,14,0" VerticalAlignment="Center" />
                    
                    <TextBlock x:Name="ModeText" Grid.Column="3" 
                               FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" 
                               Foreground="#FF6BB534" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <TextBlock Grid.Column="4" Text="·" Foreground="#88888888" VerticalAlignment="Center" Margin="6,0" />
                    <TextBlock Grid.Column="5" Text="SPACE: SWITCH" 
                               FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" 
                               Foreground="#88888888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <TextBlock Grid.Column="6" Text="·" Foreground="#88888888" VerticalAlignment="Center" Margin="6,0" />
                    <TextBlock Grid.Column="7" Text="ESC: CANCEL" 
                               FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" 
                               Foreground="#88888888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <TextBlock Grid.Column="8" Text="·" Foreground="#88888888" VerticalAlignment="Center" Margin="6,0" />
                    <TextBlock x:Name="GridText" Grid.Column="9" 
                               FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" 
                               Foreground="#88888888" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <Button Grid.Column="11" Style="{StaticResource MenuRowStyle}" Padding="8,4" 
                            Click="CancelButton_Click" ToolTip="Cancel capture">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#88888888" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="CoordsReadoutBorder"
                    Background="#800D100B"
                    BorderBrush="White"
                    BorderThickness="0.6"
                    Padding="8,4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="CoordsReadoutText"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           FontWeight="Black"
                           Foreground="White" />
            </Border>
        </Grid>
    </Border>
</Window>