<Window x:Class="Textractor.Windows.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="400"
        Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Border x:Name="ToastBorder"
            Background="#CC0D100B"
            BorderBrush="#FF6BB534"
            BorderThickness="1"
            Padding="14"
            MaxWidth="360"
            RenderTransformOrigin="0.5,0.5"
            Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ToastScale" ScaleX="0.9" ScaleY="0.9" />
                <TranslateTransform x:Name="ToastTranslate" X="0" Y="-20" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>
        
        <StackPanel x:Name="ContentPanel" Orientation="Vertical">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Border x:Name="StatusIconBorder"
                        Grid.Column="0"
                        Width="34" Height="34"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top">
                    <Border.Background>
                        <SolidColorBrush x:Name="StatusIconBackground" Color="Transparent" />
                    </Border.Background>
                    <TextBlock x:Name="StatusIcon"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               FontWeight="Black"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock x:Name="HeadlineText"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="TimestampText"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               Foreground="#88888888"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            
            <TextBlock x:Name="BodyText"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="13"
                       Foreground="#CCCCCCCC"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            
            <StackPanel x:Name="AnalysisPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Border x:Name="SentimentChip"
                        Background="Transparent"
                        Padding="8,4"
                        BorderThickness="0.8"
                        BorderBrush="Transparent"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SentimentIcon" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" />
                        <TextBlock x:Name="SentimentText"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   FontWeight="Black" />
                    </StackPanel>
                </Border>
                
                <Border x:Name="LanguageChip"
                        Background="Transparent"
                        Padding="8,4"
                        BorderThickness="0.8"
                        BorderBrush="Transparent"
                        Visibility="Collapsed"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="Purple" Margin="0,0,4,0" />
                        <TextBlock x:Name="LanguageText"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   FontWeight="Black"
                                   Foreground="Purple" />
                    </StackPanel>
                </Border>
                
                <Border x:Name="TokensChip"
                        Background="Transparent"
                        Padding="8,4"
                        BorderThickness="0.8"
                        BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="Orange" Margin="0,0,4,0" />
                        <TextBlock x:Name="TokensText"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   FontWeight="Black"
                                   Foreground="Orange" />
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <Border Height="1" Background="#4DCCCCCCCC" x:Name="DividerBorder" />
            
            <StackPanel x:Name="StorageActionsPanel"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                <TextBlock Text="SAVE THIS SCREENSHOT?"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#88888888"
                           Margin="0,0,0,6" />
                
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveButton"
                            Style="{StaticResource BreakingDadButtonStyle}"
                            Content="SAVE"
                            Tag="save"
                            Click="StorageButton_Click"
                            Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    
                    <Button x:Name="PickWhereButton"
                            Style="{StaticResource BreakingDadButtonStyle}"
                            Content="PICK WHERE..."
                            Tag="pick"
                            Click="StorageButton_Click"
                            Foreground="#FF29ABE0"
                            BorderBrush="#FF29ABE0"
                            Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    
                    <Button x:Name="DeleteButton"
                            Style="{StaticResource BreakingDadButtonStyle}"
                            Content="DELETE"
                            Tag="delete"
                            Click="StorageButton_Click"
                            Foreground="#FFB8291F"
                            BorderBrush="#FFB8291F"
                            Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    
                    <Button x:Name="AlwaysSaveButton"
                            Style="{StaticResource BreakingDadButtonStyle}"
                            Content="ALWAYS SAVE"
                            Tag="always"
                            Click="StorageButton_Click"
                            Foreground="Purple"
                            BorderBrush="Purple"
                            Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9C9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </StackPanel>
            
            <StackPanel x:Name="ActionRowPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Button x:Name="CopyButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Click="CopyButton_Click"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF29ABE0" Margin="0,0,5,0" />
                                <TextBlock Text="COPY" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" Foreground="#FF29ABE0" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button x:Name="ShareMailButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Tag="mail"
                        Click="ShareButton_Click"
                        Foreground="Blue"
                        BorderBrush="Blue"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" />
                                <TextBlock Text="MAIL" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button x:Name="ShareMessageButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Tag="message"
                        Click="ShareButton_Click"
                        Foreground="Green"
                        BorderBrush="Green"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" />
                                <TextBlock Text="MESSAGE" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button x:Name="ShareAirDropButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Tag="airdrop"
                        Click="ShareButton_Click"
                        Foreground="Orange"
                        BorderBrush="Orange">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" />
                                <TextBlock Text="AIRDROP" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
            
            <StackPanel x:Name="FailureActionsPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Button x:Name="RetryButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Content="RETRY"
                        Click="RetryButton_Click"
                        Foreground="#FF6BB534"
                        BorderBrush="#FF6BB534"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button x:Name="CancelToastButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Content="CANCEL"
                        Click="CancelToastButton_Click"
                        Foreground="#FFB8291F"
                        BorderBrush="#FFB8291F"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                
                <Button x:Name="RevealRecoveryButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Content="REVEAL"
                        Click="RevealRecoveryButton_Click"
                        Foreground="#FF29ABE0"
                        BorderBrush="#FF29ABE0"
                        Visibility="Collapsed">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
            
            <StackPanel x:Name="PermissionActionsPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Button x:Name="OpenSettingsButton"
                        Style="{StaticResource BreakingDadButtonStyle}"
                        Content="OPEN SETTINGS"
                        Click="OpenSettingsButton_Click"
                        Foreground="#FF29ABE0"
                        BorderBrush="#FF29ABE0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Black" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>