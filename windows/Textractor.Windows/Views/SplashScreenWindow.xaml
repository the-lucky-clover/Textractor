<Window x:Class="Textractor.Windows.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="540" Height="540"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Border x:Name="ShadowBorder"
                Width="460" Height="460"
                Background="#73000000"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="0,18,0,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ShadowScale" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <BlurEffect Radius="28" />
            </Border.Effect>
        </Border>

        <Border x:Name="ImageBorder"
                Width="460" Height="460"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Opacity="0"
                ClipToBounds="True">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,460,460" RadiusX="28" RadiusY="28" />
            </Border.Clip>
            <Image x:Name="SplashImage"
                   Source="pack://application:,,,/Resources/textractor-splash.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
    </Grid>
</Window>